# 默认：文本文件统一使用 LF 仓库内存储
* text=auto eol=lf

# 源码 / 文本
*.cs      text eol=lf
*.py      text eol=lf
*.md      text eol=lf
*.json    text eol=lf
*.csv     text eol=lf
*.xml     text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.txt     text eol=lf
*.sh      text eol=lf
*.csproj  text eol=lf
*.sln     text eol=crlf

# Windows 脚本保留 CRLF
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.ps1     text eol=crlf

# 二进制
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.bmp     binary
*.ico     binary
*.dll     binary
*.exe     binary
*.so      binary
*.dylib   binary
*.bin     binary
*.zip     binary
*.7z      binary
*.wav     binary
*.mp3     binary
*.mp4     binary
